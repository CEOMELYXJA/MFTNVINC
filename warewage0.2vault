                <select id="vault-mode" onchange="processSystemOption()">
                    <option value="standard">Standard Protocol Mode</option>
                    <option value="aggressive">Aggressive Optimization Mode</option>
                    <option value="stealth">Transparent Inversion Mode</option>
                </select>
                <br><br>
